# Kaushal Pramaan — backend settings. Copy to .env and adjust. Never commit real secrets.

# demo | real. demo = real ffmpeg + hashing, plus seeded DEMO ANALYSIS for the known demo video only
# (matched by SHA-256). real = only services actually installed/configured run; others are "skipped".
KP_MODE=demo

# SQLite by default (file under database/). PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://kp:kp@localhost:5432/kp   (pip install "psycopg[binary]")
# DATABASE_URL=sqlite:///C:/path/to/kushal-praman/database/kp.db

# Required in any shared deployment: long random string (signs JWTs and media tokens).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Media (video) links are HMAC-signed and expire after this many seconds.
MEDIA_TOKEN_TTL_S=900

# Uploads are stored content-addressed under STORAGE_DIR/uploads/<sha256>.<ext>
# STORAGE_DIR=C:/path/to/kushal-praman/storage
# The demo practical video used for DEMO ANALYSIS matching:
# DEMO_ASSET_PATH=C:/path/to/kushal-praman/storage/demo/practical_demo.mp4
MAX_UPLOAD_MB=300
ALLOWED_MIME_TYPES=video/mp4,video/webm,video/quicktime,image/jpeg,image/png,image/webp,audio/webm,audio/ogg,audio/mpeg,audio/wav,audio/mp4,application/pdf

# Honesty thresholds: agreement (kappa) and pilot metrics stay null below these counts.
KAPPA_MIN_PAIRS=30
METRIC_MIN_N=10

# ---- Optional AI providers (leave empty => reported "unavailable", never faked) ----
# LLM descriptions + vision tags. auto = Claude if ANTHROPIC_API_KEY, else Gemini if GEMINI_API_KEY.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Speech-to-text: none | faster_whisper (pip install faster-whisper; model downloads on first use)
ASR_PROVIDER=none
ASR_MODEL=small
# OCR: auto | tesseract | none (needs pytesseract + the Tesseract binary)
OCR_PROVIDER=auto
# ffmpeg scene-change threshold and fallback window length (seconds)
SCENE_THRESHOLD=0.15
FALLBACK_WINDOW_S=30

# Static UI (Next.js export) served at / when this folder exists.
# FRONTEND_DIST=C:/path/to/kushal-praman/frontend/out
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
